<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Hands the downloaded Visual Studio Code installer (an EXE, the System Installer) to CimianImporter, which publishes it as a new version of the item into a Cimian repository (as a copy of the item's newest pkginfo, with what belongs to the installer file replaced), or says that nothing is new. For an EXE CimianImporter is given the version label: the recipe passes the productVersion that Microsoft's release file gives (such as 1.146.0). The label must equal the version that a person reads in the installer itself, which is checked at the first dry run. This is a dry run, which writes nothing, until the recipe's override sets cimian_dry_run to false. The repository is the input cimian_repo or the AutoPkg preference CIMIAN_REPO.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.cimian.VisualStudioCode</string>
        <key>Input</key>
        <dict>
            <key>CIMIAN_NAME</key>
            <string>vscode</string>
            <key>CIMIAN_SUBDIRECTORY</key>
            <string></string>
            <key>NAME</key>
            <string>VisualStudioCode</string>
            <key>pkginfo</key>
            <dict>
                <key>developer</key>
                <string>Microsoft</string>
                <key>display_name</key>
                <string>Visual Studio Code</string>
            </dict>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>ParentRecipe</key>
        <string>com.github.serrc-techops.download.VisualStudioCode-Win</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/CimianImporter</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>cimian_name</key>
                    <string>%CIMIAN_NAME%</string>
                    <key>cimian_subdirectory</key>
                    <string>%CIMIAN_SUBDIRECTORY%</string>
                    <key>version</key>
                    <string>%version%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
