<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>This import is NOT verified yet: the download has no hard check (no vendor hash, no signature check). A real run is refused by the shared importer until a verification step exists, unless the override sets pcman_allow_unverified to true (the run then publishes with a WARNING, and the report says published, NOT verified). Hands the downloaded Adobe Acrobat Reader installer (an EXE) to the package tool (pcman), which publishes it as a new version of the template item into the Cimian repository, or says that nothing is new. For an EXE the package tool is given the version label: the recipe passes the version that the installer file itself carries, read by the shared WindowsExeVersion step of the download recipe (not the version of Adobe's products file). Both are shown in the dry run and must agree as a person reads them, by their numbers. Whether the package tool has a check of the same product for an EXE was NOT established. This is a dry run, which writes nothing, until the recipe's override sets pcman_dry_run to false.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.cimian.AdobeReader</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>AdobeReader</string>
            <key>PCMAN_TEMPLATE</key>
            <string>adobereader</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>ParentRecipe</key>
        <string>com.github.serrc-techops.download.AdobeReader-Win</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/PcmanImporter</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>pcman_template</key>
                    <string>%PCMAN_TEMPLATE%</string>
                    <key>pcman_version</key>
                    <string>%version%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
