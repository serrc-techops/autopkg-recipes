<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the latest Eclipse Temurin JRE for Windows (the MSI of the Java version in TEMURIN_FEATURE_VERSION, 8 by default, 64-bit) from GitHub, where the project publishes it, and checks it against the SHA-256 that the project's API gives for exactly that file. The latest release is read from the API of the Adoptium project by its own processor (AdoptiumInfoProvider, in this folder), because no shared recipe reads that answer. The recipe never stops on an unchanged download, so a failed import is tried again at the next run. The layout of the API's answer was read on 2026-10-02; the recipe was NOT run with AutoPkg, and the file on GitHub was NOT downloaded or compared with the hash.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.TemurinJRE8-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>TemurinJRE8</string>
            <key>TEMURIN_FEATURE_VERSION</key>
            <string>8</string>
            <key>TEMURIN_IMAGE_TYPE</key>
            <string>jre</string>
            <key>TEMURIN_ARCHITECTURE</key>
            <string>x64</string>
            <key>TEMURIN_OS</key>
            <string>windows</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>AdoptiumInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>temurin_feature_version</key>
                    <string>%TEMURIN_FEATURE_VERSION%</string>
                    <key>temurin_image_type</key>
                    <string>%TEMURIN_IMAGE_TYPE%</string>
                    <key>temurin_architecture</key>
                    <string>%TEMURIN_ARCHITECTURE%</string>
                    <key>temurin_os</key>
                    <string>%TEMURIN_OS%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
