<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the newest release of Zabbix Agent 2 for Windows (the MSI of the line in ZABBIX_LINE, 64-bit, with OpenSSL) from the vendor's download server and checks it against the SHA-256 that the vendor's download page gives for the file. The newest release is found by comparing the three numbers of each release, not by the order on the page. The recipe never stops on an unchanged download, so a failed import is tried again at the next run. It has its own processor (ZabbixAgentInfoProvider, in this folder) because the page holds its records as JSON, and no shared recipe reads them.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.ZabbixAgent2-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>ZabbixAgent2</string>
            <key>ZABBIX_LINE</key>
            <string>7.0</string>
            <key>ZABBIX_PLATFORM</key>
            <string>Windows</string>
            <key>ZABBIX_ARCHITECTURE</key>
            <string>amd64</string>
            <key>ZABBIX_ENCRYPTION</key>
            <string>OpenSSL</string>
            <key>ZABBIX_PACKAGING</key>
            <string>MSI</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>ZabbixAgentInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>zabbix_line</key>
                    <string>%ZABBIX_LINE%</string>
                    <key>zabbix_platform</key>
                    <string>%ZABBIX_PLATFORM%</string>
                    <key>zabbix_architecture</key>
                    <string>%ZABBIX_ARCHITECTURE%</string>
                    <key>zabbix_encryption</key>
                    <string>%ZABBIX_ENCRYPTION%</string>
                    <key>zabbix_packaging</key>
                    <string>%ZABBIX_PACKAGING%</string>
                    <key>zabbix_agent_type</key>
                    <string>agent2</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
