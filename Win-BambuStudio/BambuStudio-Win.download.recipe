<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the current release of Bambu Studio for Windows (the public .exe installer asset of the newest non-pre-release on GitHub that has a matching file, kept under the asset's own file name), checks it against the SHA-256 that GitHub records for the asset, and reads the version label from the .exe itself (its ProductVersion), because the release's tag belongs to the release and not to the file. The recipe never stops on an unchanged download, so a failed import is tried again at the next run. The asset name pattern is from the writer's knowledge and was NOT checked against the real release page: the first run on the build Mac checks it. If no asset matches, the run stops and nothing is written. Pre-releases are skipped unless the override sets the input include_prereleases to true.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.BambuStudio-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>BambuStudio</string>
            <key>SEARCH_PATTERN</key>
            <string>Bambu_Studio_win_public-v[0-9.]+-[0-9]+\.exe$</string>
            <key>include_prereleases</key>
            <false/>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>GitHubReleasesInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>github_repo</key>
                    <string>bambulab/BambuStudio</string>
                    <key>asset_regex</key>
                    <string>%SEARCH_PATTERN%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/GitHubAssetDigest</string>
                <key>Arguments</key>
                <dict>
                    <key>github_asset_api_url</key>
                    <string>%asset_url%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/WindowsExeVersion</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
