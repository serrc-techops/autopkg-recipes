<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads Microsoft's redistributable zip of the Windows App Runtime (release WINDOWSAPPRUNTIME_RELEASE, default 1.4) from Microsoft's fixed address, which redirects to a file under download.microsoft.com, checks the zip against the SHA-256 in the input REDIST_SHA256 (ChecksumVerifier), and takes the framework package for one architecture (an .msix; default x64) out of it with this folder's processor WindowsAppRuntimeFrameworkExtractor, which becomes the pathname that the importers get. REDIST_SHA256 is NOT a checksum that Microsoft publishes (it publishes none that was found; the file's ETag is not its SHA-256): it is the SHA-256 of the file that was read on 2026-11-16 (release 1.4.240802001), kept in this recipe as our own record. It proves that the zip is the same file; when Microsoft changes the file, the run stops at the checksum step with nothing written, and a person looks at the new file and sets the new value in the override's Input. The package's own version is read by the importers from its manifest. On 2026-11-16 this recipe ran under AutoPkg 2.9.0 into a scratch Cimian repository (dry run, real run, second run; the checksum step verified the zip and the extractor wrote the x64 package); it has not run against a real repository. The recipe never stops on an unchanged download, so a failed import is tried again at the next run.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.WindowsAppRuntime-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>WindowsAppRuntime</string>
            <key>REDIST_SHA256</key>
            <string>62af3d28e16bed99282abaf61817a36b02f97e5f9de756715a74d4b85930a8c3</string>
            <key>WINDOWSAPPRUNTIME_ARCHITECTURE</key>
            <string>x64</string>
            <key>WINDOWSAPPRUNTIME_RELEASE</key>
            <string>1.4</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
                <key>Arguments</key>
                <dict>
                    <key>url</key>
                    <string>https://aka.ms/windowsappsdk/%WINDOWSAPPRUNTIME_RELEASE%/latest/Microsoft.WindowsAppRuntime.Redist.%WINDOWSAPPRUNTIME_RELEASE%.zip</string>
                    <key>filename</key>
                    <string>Microsoft.WindowsAppRuntime.Redist.%WINDOWSAPPRUNTIME_RELEASE%.zip</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%REDIST_SHA256%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>WindowsAppRuntimeFrameworkExtractor</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>windowsappruntime_release</key>
                    <string>%WINDOWSAPPRUNTIME_RELEASE%</string>
                    <key>windowsappruntime_architecture</key>
                    <string>%WINDOWSAPPRUNTIME_ARCHITECTURE%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
