<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Description</key>
	<string>Stub recipe. It does nothing. It carries the identifier that lets other recipes name the processor in this folder: com.github.serrc-techops.PcmanProcessors/PcmanImporter. That processor hands a download to the package tool (pcman); it needs that tool, which is not part of this repository. A recipe that works with any Cimian repository uses com.github.serrc-techops.SharedProcessors/CimianImporter instead.</string>
	<key>Identifier</key>
	<string>com.github.serrc-techops.PcmanProcessors</string>
	<key>Input</key>
	<dict/>
	<key>MinimumVersion</key>
	<string>1.0.0</string>
	<key>Process</key>
	<array/>
</dict>
</plist>
