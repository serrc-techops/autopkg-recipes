<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Hands the downloaded WizTree installer (an .exe) to the package tool (pcman), which publishes it as a new version of the template item into the Cimian repository, or says that nothing is new. The version label is the one that the download recipe's processor took from the installer's file name (4_33 gives 4.33), as written; the package tool does not read a version from an .exe. This is a dry run, which writes nothing, until the recipe's override sets pcman_dry_run to false. This recipe has not been run by anyone yet. WizTree is free for personal use only: whether an organisation needs the vendor's licence is a question to settle before the item goes into a manifest.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.pcman.WizTree</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>WizTree</string>
            <key>PCMAN_TEMPLATE</key>
            <string>wiztree</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>ParentRecipe</key>
        <string>com.github.serrc-techops.download.WizTree-Win</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.PcmanProcessors/PcmanImporter</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>pcman_template</key>
                    <string>%PCMAN_TEMPLATE%</string>
                    <key>pcman_version</key>
                    <string>%version%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
