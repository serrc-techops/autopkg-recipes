<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the current release of 7-Zip for Windows (the 64-bit .exe asset of the newest non-pre-release on GitHub that has a matching file, kept under the asset's own file name) and checks it against the SHA-256 that GitHub records for the asset. The recipe never stops on an unchanged download, so a failed import is tried again at the next run. It is written for the .exe, not the .msi, so the shared 7zip-Win64.download recipe (pattern and file name for the .msi) is not its parent. Pre-releases are skipped unless the override sets the input include_prereleases to true. The step GitHubNewestReleaseGuard, right after the provider, stops the run when the release that the provider selected is not the newest release (a pre-release is skipped unless include_prereleases is true): it names the newest release and its files. The override's input accepted_newest_release, set to the tag of a newest release that has no Windows installer file (.msi, .exe, .msix) on purpose, lets the run go on only while that release is the newest, and release_tag_pattern names the line of releases to follow for a vendor with two lines (every run names the newer releases that it left out).</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.7Zip-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>7Zip</string>
            <key>SEARCH_PATTERN</key>
            <string>7z[0-9]+-x64\.exe</string>
            <key>accepted_newest_release</key>
            <string></string>
            <key>include_prereleases</key>
            <false/>
            <key>release_tag_pattern</key>
            <string></string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>GitHubReleasesInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>github_repo</key>
                    <string>ip7z/7zip</string>
                    <key>asset_regex</key>
                    <string>%SEARCH_PATTERN%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/GitHubNewestReleaseGuard</string>
                <key>Arguments</key>
                <dict>
                    <key>github_asset_api_url</key>
                    <string>%asset_url%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/GitHubAssetDigest</string>
                <key>Arguments</key>
                <dict>
                    <key>github_asset_api_url</key>
                    <string>%asset_url%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
