<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the current release of osquery for Windows (the .msi asset of the newest non-pre-release on GitHub that has a matching file, kept under the asset's own file name) and checks it against the SHA-256 that GitHub records for the asset. The recipe never stops on an unchanged download, so a failed import is tried again at the next run. The pattern for the asset's name and the digest were checked against GitHub's release list on 2026-10-04 (the newest six releases: one .msi each, every asset with a recorded digest); the recipe was NOT run with AutoPkg and the MSI was not opened. Pre-releases are skipped unless the override sets the input include_prereleases to true.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.Osquery-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>Osquery</string>
            <key>SEARCH_PATTERN</key>
            <string>osquery-[0-9.]+\.msi$</string>
            <key>include_prereleases</key>
            <false/>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>GitHubReleasesInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>github_repo</key>
                    <string>osquery/osquery</string>
                    <key>asset_regex</key>
                    <string>%SEARCH_PATTERN%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/GitHubAssetDigest</string>
                <key>Arguments</key>
                <dict>
                    <key>github_asset_api_url</key>
                    <string>%asset_url%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
