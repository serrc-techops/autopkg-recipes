<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Builds a custom, unsigned ReportMateClientMac package. It patches Scripts/postinstall so it never moves an existing postflight.d/ runner (such as Zentral's Munki package) out of place -- moving it is what makes the postflight run itself without end -- and never downloads or installs osquery, which Munki provides instead. Run this recipe, sign and notarize its output, then import it with ReportMateClientMac.munki.recipe -k PKG=/path/to/the/signed/package.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.pkg.ReportMateClientMac</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>ReportMateClientMac</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>ParentRecipe</key>
        <string>com.github.serrc-techops.download.ReportMateClientMac</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>FlatPkgUnpacker</string>
                <key>Arguments</key>
                <dict>
                    <key>flat_pkg_path</key>
                    <string>%pathname%</string>
                    <key>destination_path</key>
                    <string>%RECIPE_CACHE_DIR%/%NAME%-unpacked</string>
                    <key>purge_destination</key>
                    <true/>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>ReportMatePostinstallPatcher</string>
                <key>Arguments</key>
                <dict>
                    <key>expanded_pkg_path</key>
                    <string>%RECIPE_CACHE_DIR%/%NAME%-unpacked</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>FlatPkgPacker</string>
                <key>Arguments</key>
                <dict>
                    <key>source_flatpkg_dir</key>
                    <string>%RECIPE_CACHE_DIR%/%NAME%-unpacked</string>
                    <key>destination_pkg</key>
                    <string>%RECIPE_CACHE_DIR%/%NAME%-%version%-custom.pkg</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
