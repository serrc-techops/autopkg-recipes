<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the current release version of the ReportMate macOS client (the .pkg asset of the newest non-pre-release on GitHub, kept under the asset's own file name) and verifies it against the SHA-256 published with the release. Upstream publishes the package unsigned, so there is no signature to verify. To use a package you signed and notarized yourself, run with -k PKG=/path/to/signed.pkg; the download and the checksum comparison are then skipped.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.ReportMateClientMac</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>ReportMateClientMac</string>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>GitHubReleasesInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>github_repo</key>
                    <string>reportmate/reportmate-client-mac</string>
                    <key>asset_regex</key>
                    <string>ReportMate-[\d.]+\.pkg$</string>
                    <key>include_prereleases</key>
                    <false/>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLTextSearcher</string>
                <key>Arguments</key>
                <dict>
                    <key>url</key>
                    <string>%url%.sha256</string>
                    <key>re_pattern</key>
                    <string>([0-9a-f]{64})</string>
                    <key>result_output_var_name</key>
                    <string>expected_sha256</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>ReportMateChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pkg_path</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
