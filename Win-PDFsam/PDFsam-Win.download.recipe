<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Description</key>
        <string>Downloads the current release of PDFsam Basic for Windows (the 64-bit .msi asset of the newest non-pre-release on GitHub that has a matching file, kept under the asset's own file name) and checks it against the SHA-256 that GitHub records for the asset. When the asset has no recorded digest the run stops with an error and writes nothing: the program is then a hand import until a release with a digest exists. The asset names, sizes and digest flags were read from GitHub's release list on 2026-10-04 (the newest fourteen releases): the project names the installer like pdfsam-basic-6.0.6-windows-x64.msi and GitHub records a digest for it from version 5.3.2 on. The first run with AutoPkg 2.9.0, on 2026-10-04, took an October 2024 file named pdfsam-5.2.9.msi under the earlier pattern and stopped for a missing digest: AutoPkg takes the first release that has a matching file however old it is, so a new spelling of the name would send the recipe back to an older release; read the line that names the selected asset and release in the first dry run. The recipe never stops on an unchanged download, so a failed import is tried again at the next run. Pre-releases are skipped unless the override sets the input include_prereleases to true.</string>
        <key>Identifier</key>
        <string>com.github.serrc-techops.download.PDFsam-Win</string>
        <key>Input</key>
        <dict>
            <key>NAME</key>
            <string>PDFsam</string>
            <key>SEARCH_PATTERN</key>
            <string>pdfsam-basic-[0-9.]+-windows-x64\.msi$</string>
            <key>include_prereleases</key>
            <false/>
        </dict>
        <key>MinimumVersion</key>
        <string>1.0.0</string>
        <key>Process</key>
        <array>
            <dict>
                <key>Processor</key>
                <string>GitHubReleasesInfoProvider</string>
                <key>Arguments</key>
                <dict>
                    <key>github_repo</key>
                    <string>torakiki/pdfsam</string>
                    <key>asset_regex</key>
                    <string>%SEARCH_PATTERN%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>URLDownloader</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>EndOfCheckPhase</string>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/GitHubAssetDigest</string>
                <key>Arguments</key>
                <dict>
                    <key>github_asset_api_url</key>
                    <string>%asset_url%</string>
                </dict>
            </dict>
            <dict>
                <key>Processor</key>
                <string>com.github.serrc-techops.SharedProcessors/ChecksumVerifier</string>
                <key>Arguments</key>
                <dict>
                    <key>pathname</key>
                    <string>%pathname%</string>
                    <key>expected_sha256</key>
                    <string>%expected_sha256%</string>
                </dict>
            </dict>
        </array>
    </dict>
</plist>
