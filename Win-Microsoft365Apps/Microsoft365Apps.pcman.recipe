<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>This import is NOT verified: the download has no hard check (no vendor hash, no signature check). A real run is refused by the shared importer until the override sets pcman_allow_unverified to true (the run then publishes with a WARNING, and the report says published, NOT verified). Hands the self-extracting Microsoft 365 Apps installer that the download recipe built (an EXE of about 3.3 GB) to the package tool (pcman), which publishes it as a new version of the template item into the Cimian repository, or says that nothing is new. The version label is the Office version (16.0.x.y), which is also the version Windows shows for the installed product, so a check by the product's name and version in the Windows uninstall list follows the label. This is a dry run, which writes nothing, until the recipe's override sets pcman_dry_run to false.</string>
    <key>Identifier</key>
    <string>com.github.serrc-techops.pcman.Microsoft365Apps</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>Microsoft365Apps</string>
        <key>PCMAN_TEMPLATE</key>
        <string>office365business</string>
    </dict>
    <key>MinimumVersion</key>
    <string>1.0.0</string>
    <key>ParentRecipe</key>
    <string>com.github.serrc-techops.download.Microsoft365Apps-Win</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pathname</key>
                <string>%pathname%</string>
                <key>pcman_template</key>
                <string>%PCMAN_TEMPLATE%</string>
                <key>pcman_version</key>
                <string>%version%</string>
            </dict>
            <key>Processor</key>
            <string>com.github.serrc-techops.PcmanProcessors/PcmanImporter</string>
        </dict>
    </array>
</dict>
</plist>
